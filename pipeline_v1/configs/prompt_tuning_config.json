{
    "model_name": "bert-base-multilingual-cased",
    "num_prompt_tokens": 20,
    "embedding_dim": 768,
    "init_from_vocab": true,
    "learning_rate": 0.3,
    "weight_decay": 1e-5,
    "warmup_ratio": 0.1,
    "batch_size": 32,
    "epochs": 10,
    "max_seq_len": 128,
    "num_mask": 1,
    "probe": "mlamaf",
    "portion": "trans",
    "val_split": 0.1,
    "log_interval": 50,
    "seed": 42
}
